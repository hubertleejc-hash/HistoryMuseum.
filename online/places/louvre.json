    }
   ]
  },
  {
   "h": "Napoleon's museum",
   "when": "1803 to 1815",
   "lab": "verified",
   "people": [
    "napoleon"
   ],
   "t": "Napoleon brought paintings and statues to the Louvre from the countries he conquered, and for a few years it was called the Musée Napoléon. After his fall in 1815 about 5,000 works were sent back, though not all; Veronese's Wedding at Cana stayed.",
   "src": [
    {
     "n": "Wikipedia: Louvre",
     "u": "https://en.wikipedia.org/wiki/Louvre"
    },
    {
     "n": "Wikipedia: Napoleonic looting of art",
     "u": "https://en.wikipedia.org/wiki/Napoleonic_looting_of_art"
    }
   ]
  },
  {
   "h": "The glass pyramid",
   "when": "1989",
   "lab": "verified",
   "t": "The architect I. M. Pei's glass pyramid opened in 1989 as a new main entrance. Many Parisians hated it at first, as they had once hated the Eiffel Tower.",
   "src": [
